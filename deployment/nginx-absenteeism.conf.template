# nginx reverse proxy: public port 80 -> uvicorn on 127.0.0.1:8000.
# setup_ec2.sh substitutes __ORIGIN_SECRET__ (a random value stored only on the server and in CloudFront).
limit_req_zone $server_name zone=api_all:10m rate=30r/s;

server {
    listen 80 default_server;
    server_name _;
    server_tokens off;

    # Health check for you / monitoring; exposes only status and model version.
    location = /health {
        proxy_pass http://127.0.0.1:8000/health;
    }

    # Everything else must come through CloudFront, which adds the secret header.
    # (The security group already restricts port 80 to CloudFront; this also blocks other CloudFront distributions.)
    location / {
        if ($http_x_origin_verify != "__ORIGIN_SECRET__") { return 403; }
        limit_req zone=api_all burst=60 nodelay;
        client_max_body_size 64k;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 30s;
    }
}
